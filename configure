#!/usr/bin/env bash

set -eu
set -o pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)
. "$SCRIPT_DIR/scripts/init.bash"

# $IN_DOCKER && exit 0

st.h1 "Configuring Sub Project"
st.doing "Retrieving Git Submodule"
st.do git submodule update --init --recursive
st.done

st.h1 "Configuring the project"

st.doing 'Configuration of APP_ENV'
# shellcheck disable=SC2015
if isConfigAppEnvNeeded; then
    cp "${SCRIPT_DIR}/.envrc.example" "${SCRIPT_DIR}/.envrc"
    configAppEnv
else
    st.nothingTodo
fi

# shellcheck disable=SC1091
. "$SCRIPT_DIR/.envrc" || exit 1

st.doing 'Installing Mise-en-place'
if ! type mise &>/dev/null; then
    if type apt &>/dev/null; then
        sudo install -dm 755 /etc/apt/keyrings &&
            curl -fsSL https://mise.jdx.dev/gpg-key.pub | sudo tee /etc/apt/keyrings/mise-archive-keyring.asc >/dev/null &&
            echo "deb [signed-by=/etc/apt/keyrings/mise-archive-keyring.asc] https://mise.jdx.dev/deb stable main" | sudo tee /etc/apt/sources.list.d/mise.list >/dev/null &&
            sudo apt-get update && sudo apt-get install -y mise
    else
        curl https://mise.run | sh
    fi

    "$SCRIPT_DIR/scripts/mise-configure.sh"

    st.done
else
    st.nothingTodo
fi

mise settings experimental=true

st.doing "Activate mise in current shell"
eval "$(mise activate bash)"
st.done

st.doing "Configuring mise in standart shell"
st.do "$SCRIPT_DIR/scripts/mise-configure.sh"
st.done

st.doing 'Insalling mise usage'
st.do mise use -g usage
st.done

st.h1 'Core installation'
st.doing "Environnement installation"
st.do mise install
st.done

st.doing "Tools Installation"
st.do "$SCRIPT_DIR/scripts/install-tools-ss.sh"
st.done
