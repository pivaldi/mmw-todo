layout {
    pane split_direction="horizontal" {

        pane command="mise" {
            args "run" "db:up"
            close_on_exit true
        }

        pane command="mise" {
            name "Todo API Server"
            args "run" "run:dev"
            close_on_exit false
        }

        pane command="mise" {
            name "Todo WEB Server"
            args "run" "web:start"
            close_on_exit false
        }
    }

    // Bottom Pane: The built-in Zellij status bar (for that clean TUI look)
    pane size=1 borderless=true {
        plugin location="zellij:status-bar"
    }
}
